<?xml version="1.0" encoding="utf-8"?>
<!-- All three layers are present. A <monochrome> entry pointing at a drawable
     that does not exist is what broke every release build once
     (docs/instructions.md §5.1 B12), so each reference here has a matching PNG
     in every density bucket. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
